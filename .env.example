# App
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# LLM Provider (groq or gemini)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Embeddings (openai, cohere, or none)
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=your_embedding_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=20

# RAG
DEFAULT_STRATEGY=hybrid-rerank-mmr
DEFAULT_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MMR_LAMBDA=0.7

# System Prompt
SYSTEM_PROMPT=You are a helpful assistant. Answer the user's question based on the provided context. If the context doesn't contain enough information, say so clearly. Cite sources where applicable using [Source N] notation.

# Storage
UPLOAD_DIR=./uploads
DATA_DIR=./data

# Timeouts (seconds)
EMBEDDING_TIMEOUT=30
LLM_TIMEOUT=60
LLM_STREAM_TIMEOUT=120

# Database (for future use)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragger
REDIS_URL=redis://localhost:6379/0
