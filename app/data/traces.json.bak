 SwiftUI use scenes for?", "system_tokens": 105, "context_tokens": 482, "user_tokens": 8, "total_tokens": 595}, "llm": {"provider": "groq", "model": "openai/gpt-oss-120b", "latency_ms": 723, "input_tokens": null, "output_tokens": 11, "total_tokens": null, "answer": "I could not find that information in the provided documents.", "status": "completed"}, "sources": [{"document_id": "907f917b-3caa-4157-b94d-208635baaea9", "document_name": "Combine | Apple Developer Documentation.pdf", "page": 1, "section": null, "chunk_id": "b8facd33-692a-4ffd-9f3e-168f3f78d04f", "retrieval_method": "final", "score": 0.0}, {"document_id": "907f917b-3caa-4157-b94d-208635baaea9", "document_name": "Combine | Apple Developer Documentation.pdf", "page": 1, "section": null, "chunk_id": "eb603e2c-4ed9-42e6-b039-92056b6c568e", "retrieval_method": "final", "score": 0.0}, {"document_id": "907f917b-3caa-4157-b94d-208635baaea9", "document_name": "Combine | Apple Developer Documentation.pdf", "page": 2, "section": "Combine", "chunk_id": "2e1daa1b-ece7-4af3-99a3-04b479fc879b", "retrieval_method": "final", "score": 0.0}, {"document_id": "907f917b-3caa-4157-b94d-208635baaea9", "document_name": "Combine | Apple Developer Documentation.pdf", "page": 6, "section": "Using Combine for Your App\u02bcs Asynchronous Code", "chunk_id": "e1f33e2b-8b41-4e9a-ac31-9f392f45f238", "retrieval_method": "final", "score": 0.0}, {"document_id": "907f917b-3caa-4157-b94d-208635baaea9", "document_name": "Combine | Apple Developer Documentation.pdf", "page": 4, "section": "Subscribers", "chunk_id": "ad2ad6a2-e768-43f9-a28f-86929b6041d0", "retrieval_method": "final", "score": 0.0}], "total_latency_ms": 726, "status": "completed", "error": null, "vector_search": null, "bm25": {"latency_ms": 0, "chunk_count": 5, "query_terms": ["what", "does", "swiftui", "use", "scenes", "for"], "results": [{"chunk_id": "b8facd33-692a-4ffd-9f3e-168f3f78d04f", "document_name": "Combine | Apple Developer Documentation.pdf", "page": 1, "score": 3.6