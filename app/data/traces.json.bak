ARY", "content": "SUMMARY :", "token_count": 2, "score": 0.0, "method": "final"}, {"chunk_id": "e2043c46-0c77-4a91-9003-0608b4db96f0", "document_id": "8177355b-c628-43dd-a302-d4b444981907", "document_name": "Midhun React Native 4+.pdf", "page": 9, "section": "Experience", "content": "Access a comprehensive database of user experiences and feedback on various products and services to make informed choices. Responsibilities:", "token_count": 25, "score": 0.0, "method": "final"}, {"chunk_id": "f07ee3c1-ba47-490f-82d1-c9580f97047f", "document_id": "8177355b-c628-43dd-a302-d4b444981907", "document_name": "Midhun React Native 4+.pdf", "page": 9, "section": "Experience", "content": "Implemented the complete insurance flow, including document submission, policy details, and status tracking.", "token_count": 17, "score": 0.0, "method": "final"}, {"chunk_id": "4bc17e78-0a7d-498d-8bba-cf053e9c9e50", "document_id": "8177355b-c628-43dd-a302-d4b444981907", "document_name": "Midhun React Native 4+.pdf", "page": 5, "section": "Responsibilities", "content": "Built resume upload and cover letter management features with seamless document handling and validation.", "token_count": 18, "score": 0.0, "method": "final"}], "total_tokens": 82, "chunk_count": 5, "document_count": 1}, "prompt": {"system": "You are a RAG assistant. Answer the user's question using ONLY the provided context.\n\nUnderstand the question semantically and consider relevant information from different perspectives within the context. Do not rely on outside knowledge, assumptions, or hallucinations.\n\nIf the answer is not supported by the context, say: \"I couldn't find that information in the provided context.\"\n\nGive a clear, direct answer and include relevant details from the context when useful.", "context": "<retrieved_context>\n\n<source id=\"1\">\n  <document>\n    Midhun React Native 4+.pdf\n  </document>\n  <page>9</page>\n  <section>Experience</section>\n  <relevance>high</relevance>\n\n  <content>\n    I