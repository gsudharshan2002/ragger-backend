 15:52:52.234807+00:00", "query": "My code reads pull_request.merge_commit_sha after a merge completes. Will that still work on the current API version, and if not what should I do instead?", "strategy": "bm25", "config": {"strategy": "bm25", "vector": {"embedding_model": "sentence-transformers/all-MiniLM-L6-v2", "top_k": 5, "similarity": "cosine", "similarity_threshold": 0.0}, "bm25": {"top_k": 5, "language": "english", "tokenizer": "standard"}, "rrf": {"k": 60, "vector_weight": 1.0, "bm25_weight": 1.0, "top_n": 5}, "reranker": {"enabled": false, "model": "cross-encoder/ms-marco-MiniLM-L-6-v2", "candidate_count": 5, "top_n": 5}, "mmr": {"enabled": false, "lambda_": 0.7, "candidate_count": 5, "final_count": 5}, "llm": {"model": "openai/gpt-oss-120b", "temperature": 0.7, "top_p": 1.0, "max_tokens": 1024}}, "events": [{"stage": "query", "event": "query.started", "data": {"query": "My code reads pull_request.merge_commit_sha after a merge completes. Will that still work on the current API version, and if not what should I do instead?", "strategy": "bm25", "request_id": "132d442c-0202-4211-b514-1befcc5d4464", "knowledge_base_id": null}, "timestamp": "2026-09-03T15:44:36.218764+00:00"}, {"stage": "query", "event": "query.processed", "data": {"chunk_count": 37}, "timestamp": "2026-09-03T15:44:36.218779+00:00"}, {"stage": "bm25", "event": "bm25.started", "data": {"top_k": 5, "language": "english", "query_terms": ["my", "code", "reads", "pull_request", "merge_commit_sha"]}, "timestamp": "2026-09-03T15:44:36.218810+00:00"}, {"stage": "bm25", "event": "bm25.chunk.retrieved", "data": {"chunk_id": "61ef2290-52d1-44a8-a6fb-b23f8108e366", "rank": 1, "score": 19.61929891748951, "document": "current-version.md", "page": 1, "query_terms": ["my", "code", "reads", "pull_request", "merge_commit_sha"]}, "timestamp": "2026-09-03T15:44:36.219947+00:00"}, {"stage": "bm25", "event": "bm25.chunk.retrieved", "data": {"chunk_id": "01072a4b-f23e-4e85-87f6-41baf0d40fe2", "rank": 2, "score": 13.1